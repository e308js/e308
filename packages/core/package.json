{
  "name": "@e308/core",
  "version": "1.0.0-rc.1",
  "description": "Deterministic, headless incremental-game engine",
  "keywords": [
    "incremental-game",
    "idle-game",
    "game-engine",
    "offline-progress",
    "typescript"
  ],
  "homepage": "https://github.com/e308js/e308#readme",
  "bugs": "https://github.com/e308js/e308/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e308js/e308.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "import": "./dist/offline/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "import": "./dist/tasks/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./markets": {
      "types": "./dist/markets/index.d.ts",
      "import": "./dist/markets/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./balance": {
      "types": "./dist/balance/index.d.ts",
      "import": "./dist/balance/index.js"
    },
    "./optimize": {
      "types": "./dist/optimize/index.d.ts",
      "import": "./dist/optimize/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "break_eternity.js": "2.1.3",
    "semver": "7.8.5"
  }
}
