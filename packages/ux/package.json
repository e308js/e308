{
  "name": "@e308/ux",
  "version": "1.0.0-rc.1",
  "description": "Framework-independent UX contracts for e308 games",
  "license": "MIT",
  "keywords": [
    "incremental-game",
    "idle-game",
    "game-ui",
    "accessible",
    "typescript"
  ],
  "homepage": "https://github.com/e308js/e308#readme",
  "bugs": "https://github.com/e308js/e308/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e308js/e308.git",
    "directory": "packages/ux"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./localization": {
      "types": "./dist/localization/index.d.ts",
      "import": "./dist/localization/index.js"
    },
    "./views": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@e308/core": "workspace:*"
  }
}
