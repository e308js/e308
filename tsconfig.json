{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "lib": ["ES2024", "DOM"],
    "paths": {
      "@e308/core": ["packages/core/src/index.ts"],
      "@e308/core/balance": ["packages/core/src/balance/index.ts"],
      "@e308/core/browser": ["packages/core/src/browser/index.ts"],
      "@e308/core/calendar": ["packages/core/src/calendar/index.ts"],
      "@e308/core/markets": ["packages/core/src/markets/index.ts"],
      "@e308/core/offline": ["packages/core/src/offline/index.ts"],
      "@e308/core/optimize": ["packages/core/src/optimize/index.ts"],
      "@e308/core/persistence": ["packages/core/src/persistence/index.ts"],
      "@e308/core/storage": ["packages/core/src/storage/index.ts"],
      "@e308/core/tasks": ["packages/core/src/tasks/index.ts"],
      "@e308/core/testing": ["packages/core/src/testing/index.ts"],
      "@e308/core/worker": ["packages/core/src/worker/index.ts"],
      "@e308/ux": ["packages/ux/src/index.ts"],
      "@e308/ux/dom": ["packages/ux/src/dom/index.ts"],
      "@e308/ux/effects": ["packages/ux/src/effects/index.ts"],
      "@e308/ux/format": ["packages/ux/src/format/index.ts"],
      "@e308/ux/localization": ["packages/ux/src/localization/index.ts"],
      "@e308/ux/views": ["packages/ux/src/view/index.ts"],
      "@e308/game-cascade": ["games/cascade/src/index.ts"],
      "@e308/game-hearth": ["games/hearth/src/index.ts"],
      "@e308/game-wireworks": ["games/wireworks/src/index.ts"]
    },
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.ts",
    "games/**/*.ts",
    "reference/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ]
}
