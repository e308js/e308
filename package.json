{
  "name": "e308-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:release": "node tools/release/build.mjs",
    "build:site": "node tools/site/build.mjs",
    "check:structure": "node --experimental-strip-types tools/quality/structure.ts",
    "format": "biome check --write .",
    "lint": "biome ci --error-on-warnings .",
    "quality": "pnpm lint && pnpm typecheck && pnpm check:structure && pnpm build && pnpm build:release && pnpm build:site && pnpm report:pacing && pnpm report:finished-games && pnpm report:performance && pnpm verify:performance && pnpm test:coverage && pnpm test:packages && pnpm test:browser && pnpm verify:release",
    "report:performance": "node examples/pacing/dist/performance.js",
    "report:finished-games": "node examples/pacing/dist/finished-games.js",
    "report:pacing": "node examples/pacing/dist/generate.js",
    "verify:performance": "node tools/performance/verify.mjs",
    "verify:release": "node tools/release/verify.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:packages": "bash tests/packages/consumer.sh",
    "test:reference": "vitest run tests/reference",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "happy-dom": "19.0.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
